# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Captures écartées : elles contiennent des noms de patients (données de santé).
# Ne jamais les remettre dans public/ — tout y est servi publiquement.
/.screens-prives

# Originaux PNG fournis par le client, avant conversion en WebP.
# Conservés hors dépôt : ils pèsent dix fois le poids des fichiers servis,
# et seule la version convertie a besoin d'être déployée.
/.screens-sources

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
